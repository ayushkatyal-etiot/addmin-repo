{
  "name": "addmin",
  "version": "0.1.0",
  "private": true,
  "description": "Office Administration Management System - SaaS Platform",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.3"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
