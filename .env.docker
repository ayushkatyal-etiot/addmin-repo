# Docker environment variables
NODE_ENV=development

# Database (connects to postgres service in docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=addmin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/addmin

# NextAuth
NEXTAUTH_SECRET=dev-secret-key-min-32-characters-long-for-local-dev
NEXTAUTH_URL=http://localhost:3000

# API Configuration
API_PORT=3001
API_URL=http://api:3001

# App URLs
WEBSITE_URL=http://localhost:3000
OPERATOR_URL=http://localhost:3001
TENANT_URL=http://localhost:3002
